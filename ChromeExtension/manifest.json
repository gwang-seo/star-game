{
  "manifest_version": 3,
  "name": "CONNECT ChatGPT 답변 연결",
  "version": "1.5.0",
  "description": "ChatGPT 최신 답변 자동 전송, 수동 버튼 유지, A1 음성 읽기",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://star-game1234.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://star-game1234.netlify.app/*"
      ],
      "js": [
        "star-game.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
