{
  "manifest_version": 3,
  "name": "CONNECT ChatGPT 답변 연결",
  "version": "1.4.0",
  "description": "ChatGPT 답변을 자동 또는 클릭 한 번으로 스타게임 CONNECT A1 음성에 전달",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://star-game1234.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "chatgpt.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://star-game1234.netlify.app/*"
      ],
      "js": [
        "star-game.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
